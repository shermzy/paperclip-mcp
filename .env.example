# paperclip-mcp configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control — it is listed in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# Required — Base URL of your Paperclip instance.
# Default (local install): http://localhost:3100/api
# Change only if you have a remote or differently configured Paperclip instance.
PAPERCLIP_BASE_URL=http://localhost:3100/api

# Required — Agent API key.
# Generate in Paperclip UI: Settings → API Keys → New Key.
# Keep this secret: it grants write access to your company's data.
PAPERCLIP_API_KEY=

# Required — Company UUID to operate on.
# Find it in the Paperclip UI URL when viewing your company:
#   http://localhost:3100/companies/{PAPERCLIP_COMPANY_ID}
PAPERCLIP_COMPANY_ID=

# Required for the delegated manager facade — a Paperclip issue assigned to
# this agent and used only to establish an attributed heartbeat context.
PAPERCLIP_MANAGER_CONTEXT_ISSUE_ID=

# Required for the delegated manager facade. Set this to a project UUID for a
# narrow boundary, or explicitly set '*' to allow all projects in the company.
# An empty value is invalid; unrestricted access must be deliberate.
PAPERCLIP_ALLOWED_PROJECT_ID=
